{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/julie-elkins/agent-assurance-harness/blob/main/schemas/source-evidence-receipt-v1.json",
  "title": "Source evidence receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_evidence_receipt_version",
    "receipt_id",
    "evidence_id",
    "claim_id",
    "source_id",
    "authority",
    "source_url",
    "source_locator",
    "retrieved_at",
    "document_updated_at",
    "source_digest",
    "scope",
    "lookup_status",
    "support_status",
    "human_disposition",
    "limitations",
    "what_it_does_not_show"
  ],
  "properties": {
    "source_evidence_receipt_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "source_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "source_locator": {
      "type": ["string", "null"]
    },
    "retrieved_at": { "type": "string", "minLength": 1 },
    "document_updated_at": {
      "type": ["string", "null"]
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_scope": { "type": "string", "minLength": 1 },
        "api_version": { "type": "string", "minLength": 1 },
        "guide_version": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "partition": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "source_role": { "type": "string", "minLength": 1 }
      }
    },
    "lookup_status": {
      "enum": ["completed", "not_checked", "unavailable", "refused", "failed"]
    },
    "support_status": {
      "enum": [
        "supports",
        "contradicts",
        "insufficient",
        "conflict",
        "not_evaluated"
      ]
    },
    "human_disposition": {
      "enum": ["pending_review", "accepted", "rejected", "needs_review"]
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "what_it_does_not_show": {
      "type": "string",
      "minLength": 1
    }
  }
}
