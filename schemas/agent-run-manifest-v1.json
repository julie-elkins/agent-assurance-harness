{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/julie-elkins/agent-assurance-harness/blob/main/schemas/agent-run-manifest-v1.json",
  "title": "Agent run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "decision_target",
    "actor_id",
    "agent_id",
    "provider",
    "model",
    "revisions",
    "tool_scope",
    "budget",
    "checkpoint",
    "repeatability",
    "grader_version",
    "evidence",
    "created_at"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_target": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "harness",
        "prompt",
        "tools",
        "policy",
        "data",
        "repository",
        "environment",
        "grader"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "grader": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "limits",
        "stop_condition",
        "within_limits"
      ],
      "properties": {
        "observed": {
          "$ref": "#/$defs/usage"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        },
        "within_limits": {
          "type": "boolean"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "checkpoint_revision",
        "resume_supported"
      ],
      "properties": {
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "resume_supported": {
          "type": "boolean"
        }
      }
    },
    "repeatability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_count",
        "successful_run_count",
        "variance"
      ],
      "properties": {
        "run_count": {
          "type": "integer",
          "minimum": 1
        },
        "successful_run_count": {
          "type": "integer",
          "minimum": 0
        },
        "variance": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "grader_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "digest",
        "expires_at",
        "observed_outcome"
      ],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observed_outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "output_tokens",
        "elapsed_seconds",
        "estimated_cost_usd"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "max_output_tokens",
        "max_elapsed_seconds",
        "max_estimated_cost_usd"
      ],
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_elapsed_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_estimated_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
