{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/julie-elkins/agent-assurance-harness/blob/main/schemas/review-workflow-assurance-v1.json",
  "title": "Review workflow assurance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_assurance_version",
    "run_id",
    "workflow_version",
    "source_revision",
    "stages_expected",
    "stage_statuses",
    "counts",
    "refusals",
    "evidence",
    "artifact_hashes",
    "resources",
    "content_boundary",
    "human_decision"
  ],
  "properties": {
    "workflow_assurance_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "workflow_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stages_expected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "stage_statuses": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "completed",
          "refused",
          "skipped",
          "failed",
          "not_applicable"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "routed",
        "incomplete"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "routed": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.:-]+$"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required",
        "observed",
        "missing"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "not_evaluated"
          ]
        },
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "limits",
        "within_limits"
      ],
      "properties": {
        "observed": {
          "$ref": "#/$defs/resource_values"
        },
        "limits": {
          "$ref": "#/$defs/resource_values"
        },
        "within_limits": {
          "type": "boolean"
        }
      }
    },
    "content_boundary": {
      "const": "metadata_only"
    },
    "human_decision": {
      "const": "required"
    }
  },
  "$defs": {
    "resource_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls",
        "elapsed_seconds",
        "output_bytes"
      ],
      "properties": {
        "tool_calls": {
          "type": "number",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "output_bytes": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
