{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/shadow-execution-v1.json",
  "title": "Synthetic shadow execution fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shadow_execution_version",
    "data_class",
    "purpose",
    "cases"
  ],
  "properties": {
    "shadow_execution_version": {
      "const": 1
    },
    "data_class": {
      "const": "synthetic"
    },
    "purpose": {
      "$ref": "#/$defs/identifier"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "action",
        "simulation"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "simulation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "expected_decision"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "matched",
                "mismatched",
                "not_observed",
                "ambiguous"
              ]
            },
            "expected_decision": {
              "enum": [
                "allow",
                "block",
                "human_review"
              ]
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "operation_id",
        "tool_name",
        "effect_class",
        "intended_effect",
        "policy_revision",
        "authority_status",
        "requires_human_approval"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "tool_name": {
          "$ref": "#/$defs/identifier"
        },
        "effect_class": {
          "$ref": "#/$defs/identifier"
        },
        "intended_effect": {
          "$ref": "#/$defs/identifier"
        },
        "policy_revision": {
          "$ref": "#/$defs/identifier"
        },
        "authority_status": {
          "enum": [
            "granted",
            "missing",
            "revoked"
          ]
        },
        "requires_human_approval": {
          "type": "boolean"
        }
      }
    }
  }
}
